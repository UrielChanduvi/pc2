@model IEnumerable<PortalInmobiliario.Models.Visita>
@{
    ViewData["Title"] = "Agenda del Día";
    var fecha = ViewBag.Fecha as DateTime? ?? DateTime.Today;
}
<h2>Agenda del Día (@fecha.ToShortDateString())</h2>
<form method="get">
    <input type="date" name="fecha" value="@fecha.ToString("yyyy-MM-dd")" />
    <button type="submit" class="btn btn-primary">Ver</button>
</form>
<table class="table">
    <thead>
        <tr>
            <th>Inmueble</th>
            <th>Usuario</th>
            <th>Inicio</th>
            <th>Fin</th>
            <th>Estado</th>
            <th>Notas</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.Inmueble?.Titulo</td>
                <td>@v.UsuarioId</td>
                <td>@v.FechaInicio.ToShortTimeString()</td>
                <td>@v.FechaFin.ToShortTimeString()</td>
                <td>@v.Estado</td>
                <td>@v.Notas</td>
                <td>
                    @if (v.Estado == PortalInmobiliario.Models.EstadoVisita.Solicitada)
                    {
                        <form asp-action="Confirmar" asp-route-id="@v.Id" method="post" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-success">Confirmar</button>
                        </form>
                        <form asp-action="Cancelar" asp-route-id="@v.Id" method="post" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-danger">Cancelar</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
