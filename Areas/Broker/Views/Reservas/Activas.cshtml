@model IEnumerable<PortalInmobiliario.Models.Reserva>
@{
    ViewData["Title"] = "Reservas Activas";
}
<h2>Reservas Activas</h2>
<table class="table">
    <thead>
        <tr>
            <th>Inmueble</th>
            <th>Usuario</th>
            <th>Creación</th>
            <th>Expiración</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Inmueble?.Titulo</td>
                <td>@r.UsuarioId</td>
                <td>@r.FechaCreacion.ToString("g")</td>
                <td>@r.FechaExpiracion.ToString("g")</td>
                <td>
                    <form asp-action="Liberar" asp-route-id="@r.Id" method="post" style="display:inline">
                        <button type="submit" class="btn btn-sm btn-danger">Liberar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
