@model IEnumerable<PortalInmobiliario.Models.Inmueble>
@{
    ViewData["Title"] = "Inmuebles";
}
<h2>Inmuebles</h2>
<a asp-action="Create" class="btn btn-primary">Crear Inmueble</a>
<table class="table">
    <thead>
        <tr>
            <th>Título</th>
            <th>Tipo</th>
            <th>Ciudad</th>
            <th>Precio</th>
            <th>Activo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model)
        {
            <tr>
                <td>@i.Titulo</td>
                <td>@i.Tipo</td>
                <td>@i.Ciudad</td>
                <td>@i.Precio</td>
                <td>@i.Activo</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@i.Id" class="btn btn-sm btn-warning">Editar</a>
                    <form asp-action="Activar" asp-route-id="@i.Id" method="post" style="display:inline">
                        <button type="submit" class="btn btn-sm btn-secondary">@(i.Activo ? "Desactivar" : "Activar")</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
