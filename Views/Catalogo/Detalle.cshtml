@model PortalInmobiliario.Models.Inmueble
@{
    ViewData["Title"] = "Detalle de Inmueble";
}
<h2>@ViewData["Title"]</h2>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<div class="card mb-3">
    <div class="card-body">
        <h4>@Model.Titulo</h4>
        <p><strong>Código:</strong> @Model.Codigo</p>
        <p><strong>Tipo:</strong> @Model.Tipo</p>
        <p><strong>Ciudad:</strong> @Model.Ciudad</p>
        <p><strong>Dirección:</strong> @Model.Direccion</p>
        <p><strong>Dormitorios:</strong> @Model.Dormitorios</p>
        <p><strong>Baños:</strong> @Model.Banos</p>
        <p><strong>Metros²:</strong> @Model.MetrosCuadrados</p>
        <p><strong>Precio:</strong> @Model.Precio.ToString("C")</p>
        <a asp-action="Index" class="btn btn-secondary">Volver al catálogo</a>
        @if (!(ViewBag.ReservaActiva ?? false))
        {
            <form asp-action="ReservarAhora" method="post" class="d-inline">
                <input type="hidden" name="InmuebleId" value="@Model.Id" />
                <button type="submit" class="btn btn-warning ms-2">Reservar ahora (48h)</button>
            </form>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5>Agendar visita</h5>
        <form asp-action="AgendarVisita" method="post">
            <input type="hidden" name="InmuebleId" value="@Model.Id" />
            <div class="mb-2">
                <label>Fecha Inicio</label>
                <input type="datetime-local" name="FechaInicio" class="form-control" required />
            </div>
            <div class="mb-2">
                <label>Fecha Fin</label>
                <input type="datetime-local" name="FechaFin" class="form-control" required />
            </div>
            <div class="mb-2">
                <label>Notas</label>
                <textarea name="Notas" class="form-control"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Agendar visita</button>
        </form>
    </div>
</div>
    </div>
</div>
